{
  "investigations.json": {
    "$defs": {
      "Investigation": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "PSI accession, e.g. \"PSI-25\"",
            "pattern": "^PSI-\\d+$",
            "title": "Id",
            "type": "string"
          },
          "acronym": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acronym"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "project_type": {
            "enum": [
              "flight",
              "ground"
            ],
            "title": "Project Type",
            "type": "string"
          },
          "role": {
            "enum": [
              "prevention",
              "detection",
              "suppression",
              "fundamentals"
            ],
            "title": "Role",
            "type": "string"
          },
          "fuel_phase": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "other"
            ],
            "title": "Fuel Phase",
            "type": "string"
          },
          "hardware": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hardware"
          },
          "related": {
            "items": {
              "type": "string"
            },
            "title": "Related",
            "type": "array"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Without the https://doi.org/ prefix",
            "title": "Doi"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "hardware_family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hardware Family"
          },
          "sub_area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sub Area"
          },
          "objectives": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Objectives"
          },
          "earth_benefits": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Earth Benefits"
          },
          "n_publications": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "N Publications"
          }
        },
        "required": [
          "id",
          "acronym",
          "title",
          "project_type",
          "role",
          "fuel_phase",
          "hardware",
          "related",
          "doi",
          "url"
        ],
        "title": "Investigation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "investigations": {
        "items": {
          "$ref": "#/$defs/Investigation"
        },
        "title": "Investigations",
        "type": "array"
      }
    },
    "required": [
      "investigations"
    ],
    "title": "InvestigationsFile",
    "type": "object"
  },
  "tests.json": {
    "$defs": {
      "Source": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "minLength": 1,
            "title": "File",
            "type": "string"
          },
          "row": {
            "description": "1 = first data row under the header",
            "minimum": 1,
            "title": "Row",
            "type": "integer"
          }
        },
        "required": [
          "file",
          "row"
        ],
        "title": "Source",
        "type": "object"
      },
      "TestRow": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "investigation_id": {
            "pattern": "^PSI-\\d+$",
            "title": "Investigation Id",
            "type": "string"
          },
          "test_label": {
            "title": "Test Label",
            "type": "string"
          },
          "fuel_material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fuel Material"
          },
          "fuel_phase": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "other"
            ],
            "title": "Fuel Phase",
            "type": "string"
          },
          "o2_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ambient oxygen, % by volume",
            "title": "O2 Pct"
          },
          "pressure_kpa": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Total pressure",
            "title": "Pressure Kpa"
          },
          "flow_cm_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 for a still atmosphere",
            "title": "Flow Cm S"
          },
          "diluent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diluent"
          },
          "outcome": {
            "enum": [
              "sustained",
              "extinguished",
              "no_ignition",
              "unknown"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/$defs/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "sample": {
            "description": "True only for placeholder rows",
            "title": "Sample",
            "type": "boolean"
          },
          "assumed": {
            "description": "Fields whose value is not in the source table but assumed (the note says why); empty when nothing is assumed",
            "items": {
              "enum": [
                "o2_pct",
                "pressure_kpa",
                "flow_cm_s"
              ],
              "type": "string"
            },
            "title": "Assumed",
            "type": "array"
          },
          "extra": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extra"
          }
        },
        "required": [
          "id",
          "investigation_id",
          "test_label",
          "fuel_material",
          "fuel_phase",
          "o2_pct",
          "pressure_kpa",
          "flow_cm_s",
          "diluent",
          "outcome",
          "note",
          "source",
          "sample"
        ],
        "title": "TestRow",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "tests": {
        "items": {
          "$ref": "#/$defs/TestRow"
        },
        "title": "Tests",
        "type": "array"
      }
    },
    "required": [
      "tests"
    ],
    "title": "TestsFile",
    "type": "object"
  },
  "coverage.json": {
    "$defs": {
      "Band": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "min": {
            "description": "Inclusive lower edge",
            "title": "Min",
            "type": "number"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exclusive upper edge; null = no upper edge",
            "title": "Max"
          },
          "habitats": {
            "description": "Habitats whose range overlaps this band",
            "items": {
              "enum": [
                "cabin",
                "lunar",
                "suit"
              ],
              "type": "string"
            },
            "title": "Habitats",
            "type": "array"
          }
        },
        "required": [
          "id",
          "label",
          "min",
          "max",
          "habitats"
        ],
        "title": "Band",
        "type": "object"
      },
      "CoverageCell": {
        "additionalProperties": false,
        "properties": {
          "fuel_phase": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "other"
            ],
            "title": "Fuel Phase",
            "type": "string"
          },
          "o2_band": {
            "title": "O2 Band",
            "type": "string"
          },
          "pressure_band": {
            "title": "Pressure Band",
            "type": "string"
          },
          "n_tests": {
            "description": "0 = a gap: nothing tested here",
            "minimum": 0,
            "title": "N Tests",
            "type": "integer"
          },
          "n_pressure_assumed": {
            "description": "Tests whose pressure is assumed, not measured",
            "minimum": 0,
            "title": "N Pressure Assumed",
            "type": "integer"
          },
          "investigations": {
            "items": {
              "type": "string"
            },
            "title": "Investigations",
            "type": "array"
          },
          "outcomes": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Outcomes",
            "type": "object"
          },
          "habitats": {
            "description": "Habitats inside both bands of this cell",
            "items": {
              "enum": [
                "cabin",
                "lunar",
                "suit"
              ],
              "type": "string"
            },
            "title": "Habitats",
            "type": "array"
          }
        },
        "required": [
          "fuel_phase",
          "o2_band",
          "pressure_band",
          "n_tests",
          "n_pressure_assumed",
          "investigations",
          "outcomes",
          "habitats"
        ],
        "title": "CoverageCell",
        "type": "object"
      },
      "OffGrid": {
        "additionalProperties": false,
        "properties": {
          "fuel_phase": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "other"
            ],
            "title": "Fuel Phase",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "n_tests": {
            "minimum": 0,
            "title": "N Tests",
            "type": "integer"
          },
          "investigations": {
            "items": {
              "type": "string"
            },
            "title": "Investigations",
            "type": "array"
          }
        },
        "required": [
          "fuel_phase",
          "reason",
          "n_tests",
          "investigations"
        ],
        "title": "OffGrid",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "o2_bands": {
        "items": {
          "$ref": "#/$defs/Band"
        },
        "title": "O2 Bands",
        "type": "array"
      },
      "pressure_bands": {
        "items": {
          "$ref": "#/$defs/Band"
        },
        "title": "Pressure Bands",
        "type": "array"
      },
      "cells": {
        "items": {
          "$ref": "#/$defs/CoverageCell"
        },
        "title": "Cells",
        "type": "array"
      },
      "not_on_grid": {
        "items": {
          "$ref": "#/$defs/OffGrid"
        },
        "title": "Not On Grid",
        "type": "array"
      }
    },
    "required": [
      "o2_bands",
      "pressure_bands",
      "cells",
      "not_on_grid"
    ],
    "title": "CoverageFile",
    "type": "object"
  },
  "varied.json": {
    "$defs": {
      "ConditionSummary": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "A TestRow field, or \"extra.<key>\"",
            "title": "Field",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "status": {
            "enum": [
              "varied",
              "constant",
              "not_recorded"
            ],
            "title": "Status",
            "type": "string"
          },
          "assumed": {
            "description": "The value is an assumption, not from the source table",
            "title": "Assumed",
            "type": "boolean"
          },
          "n_with_value": {
            "minimum": 0,
            "title": "N With Value",
            "type": "integer"
          },
          "min": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min"
          },
          "max": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max"
          },
          "levels": {
            "description": "Distinct values (numbers rounded to `precision`), at most 12",
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": "Levels",
            "type": "array"
          },
          "n_levels": {
            "minimum": 0,
            "title": "N Levels",
            "type": "integer"
          },
          "precision": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Precision"
          }
        },
        "required": [
          "field",
          "label",
          "unit",
          "status",
          "assumed",
          "n_with_value",
          "min",
          "max",
          "levels",
          "n_levels",
          "precision"
        ],
        "title": "ConditionSummary",
        "type": "object"
      },
      "InvestigationVariation": {
        "additionalProperties": false,
        "properties": {
          "investigation_id": {
            "pattern": "^PSI-\\d+$",
            "title": "Investigation Id",
            "type": "string"
          },
          "n_tests": {
            "minimum": 0,
            "title": "N Tests",
            "type": "integer"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "conditions": {
            "items": {
              "$ref": "#/$defs/ConditionSummary"
            },
            "title": "Conditions",
            "type": "array"
          },
          "outcomes": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Outcomes",
            "type": "object"
          }
        },
        "required": [
          "investigation_id",
          "n_tests",
          "summary",
          "conditions",
          "outcomes"
        ],
        "title": "InvestigationVariation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "investigations": {
        "items": {
          "$ref": "#/$defs/InvestigationVariation"
        },
        "title": "Investigations",
        "type": "array"
      }
    },
    "required": [
      "investigations"
    ],
    "title": "VariedFile",
    "type": "object"
  },
  "gravity.json": {
    "$defs": {
      "GravityLevel": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "microgravity",
              "moon",
              "mars",
              "earth"
            ],
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "g": {
            "description": "Approximate gravity as a fraction of Earth's",
            "minimum": 0,
            "title": "G",
            "type": "number"
          },
          "status": {
            "enum": [
              "tested",
              "no_data",
              "comparison_only"
            ],
            "title": "Status",
            "type": "string"
          },
          "n_tests": {
            "description": "Test rows in tests.json at this gravity level",
            "minimum": 0,
            "title": "N Tests",
            "type": "integer"
          },
          "investigations": {
            "items": {
              "type": "string"
            },
            "title": "Investigations",
            "type": "array"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "id",
          "label",
          "g",
          "status",
          "n_tests",
          "investigations",
          "note"
        ],
        "title": "GravityLevel",
        "type": "object"
      },
      "PairedResult": {
        "additionalProperties": false,
        "properties": {
          "investigation_id": {
            "pattern": "^PSI-\\d+$",
            "title": "Investigation Id",
            "type": "string"
          },
          "sample": {
            "title": "Sample",
            "type": "string"
          },
          "material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Material"
          },
          "flow_direction": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Flow Direction"
          },
          "microgravity_burn_length": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Microgravity Burn Length"
          },
          "microgravity_spread_rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Microgravity Spread Rate"
          },
          "normal_gravity_burn_length": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normal Gravity Burn Length"
          },
          "normal_gravity_spread_rate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normal Gravity Spread Rate"
          },
          "source": {
            "$ref": "#/$defs/Source"
          }
        },
        "required": [
          "investigation_id",
          "sample",
          "material",
          "flow_direction",
          "microgravity_burn_length",
          "microgravity_spread_rate",
          "normal_gravity_burn_length",
          "normal_gravity_spread_rate",
          "source"
        ],
        "title": "PairedResult",
        "type": "object"
      },
      "Quote": {
        "additionalProperties": false,
        "properties": {
          "investigation_id": {
            "pattern": "^PSI-\\d+$",
            "title": "Investigation Id",
            "type": "string"
          },
          "text": {
            "description": "Copied word for word from the source",
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "source_label": {
            "title": "Source Label",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "investigation_id",
          "text",
          "source_label",
          "url"
        ],
        "title": "Quote",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "minLength": 1,
            "title": "File",
            "type": "string"
          },
          "row": {
            "description": "1 = first data row under the header",
            "minimum": 1,
            "title": "Row",
            "type": "integer"
          }
        },
        "required": [
          "file",
          "row"
        ],
        "title": "Source",
        "type": "object"
      },
      "StandIn": {
        "additionalProperties": false,
        "properties": {
          "investigation_id": {
            "pattern": "^PSI-\\d+$",
            "title": "Investigation Id",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "evidence": {
            "items": {
              "$ref": "#/$defs/Quote"
            },
            "title": "Evidence",
            "type": "array"
          }
        },
        "required": [
          "investigation_id",
          "summary",
          "evidence"
        ],
        "title": "StandIn",
        "type": "object"
      },
      "Upcoming": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "title": "Note",
            "type": "string"
          },
          "source_label": {
            "title": "Source Label",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "name",
          "note",
          "source_label",
          "url"
        ],
        "title": "Upcoming",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "summary": {
        "title": "Summary",
        "type": "string"
      },
      "levels": {
        "items": {
          "$ref": "#/$defs/GravityLevel"
        },
        "title": "Levels",
        "type": "array"
      },
      "stand_in": {
        "$ref": "#/$defs/StandIn"
      },
      "paired_results": {
        "items": {
          "$ref": "#/$defs/PairedResult"
        },
        "title": "Paired Results",
        "type": "array"
      },
      "paired_summary": {
        "description": "Counted from paired_results by plain code",
        "title": "Paired Summary",
        "type": "string"
      },
      "paired_notes": {
