{
  "investigations.json": {
    "$defs": {
      "Investigation": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "PSI accession, e.g. \"PSI-25\"",
            "pattern": "^PSI-\\d+$",
            "title": "Id",
            "type": "string"
          },
          "acronym": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acronym"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "project_type": {
            "enum": [
              "flight",
              "ground"
            ],
            "title": "Project Type",
            "type": "string"
          },
          "role": {
            "enum": [
              "prevention",
              "detection",
              "suppression",
              "fundamentals"
            ],
            "title": "Role",
            "type": "string"
          },
          "fuel_phase": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "other"
            ],
            "title": "Fuel Phase",
            "type": "string"
          },
          "hardware": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hardware"
          },
          "related": {
            "items": {
              "type": "string"
            },
            "title": "Related",
            "type": "array"
          },
          "doi": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Without the https://doi.org/ prefix",
            "title": "Doi"
          },
          "url": {
            "title": "Url",
            "type": "string"
          },
          "hardware_family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hardware Family"
          },
          "sub_area": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sub Area"
          },
          "objectives": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Objectives"
          },
          "earth_benefits": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Earth Benefits"
          },
          "n_publications": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "N Publications"
          }
        },
        "required": [
          "id",
          "acronym",
          "title",
          "project_type",
          "role",
          "fuel_phase",
          "hardware",
          "related",
          "doi",
          "url"
        ],
        "title": "Investigation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "investigations": {
        "items": {
          "$ref": "#/$defs/Investigation"
        },
        "title": "Investigations",
        "type": "array"
      }
    },
    "required": [
      "investigations"
    ],
    "title": "InvestigationsFile",
    "type": "object"
  },
  "tests.json": {
    "$defs": {
      "Source": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "minLength": 1,
            "title": "File",
            "type": "string"
          },
          "row": {
            "description": "1 = first data row under the header",
            "minimum": 1,
            "title": "Row",
            "type": "integer"
          }
        },
        "required": [
          "file",
          "row"
        ],
        "title": "Source",
        "type": "object"
      },
      "TestRow": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "investigation_id": {
            "pattern": "^PSI-\\d+$",
            "title": "Investigation Id",
            "type": "string"
          },
          "test_label": {
            "title": "Test Label",
            "type": "string"
          },
          "fuel_material": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fuel Material"
          },
          "fuel_phase": {
            "enum": [
              "solid",
              "liquid",
              "gas",
              "other"
            ],
            "title": "Fuel Phase",
            "type": "string"
          },
          "o2_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Ambient oxygen, % by volume",
            "title": "O2 Pct"
          },
          "pressure_kpa": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Total pressure",
            "title": "Pressure Kpa"
          },
          "flow_cm_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "0 for a still atmosphere",
            "title": "Flow Cm S"
          },
          "diluent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Diluent"
          },
          "outcome": {
            "enum": [
              "sustained",
              "extinguished",
              "no_ignition",
              "unknown"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "#/$defs/Source"
              },
              {
                "type": "null"
              }
            ]
          },
          "sample": {
            "description": "True only for placeholder rows",
            "title": "Sample",
            "type": "boolean"
          },
          "extra": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Extra"
          }
        },
        "required": [
          "id",
          "investigation_id",
          "test_label",
          "fuel_material",
          "fuel_phase",
          "o2_pct",
          "pressure_kpa",
          "flow_cm_s",
          "diluent",
          "outcome",
          "note",
          "source",
          "sample"
        ],
        "title": "TestRow",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "meta": {
        "additionalProperties": true,
        "title": "Meta",
        "type": "object"
      },
      "tests": {
        "items": {
          "$ref": "#/$defs/TestRow"
        },
        "title": "Tests",
        "type": "array"
      }
    },
    "required": [
      "tests"
    ],
    "title": "TestsFile",
    "type": "object"
  }
}
