# Copy to pipeline/.env (gitignored) and fill in. Never commit real keys.

# Provider: gemini | openai | fake
LLM_PROVIDER=gemini

# Exact model id from your provider's docs. For Gemini this can be a comma-separated
# list: the free tier allows about 20 requests per model per day, and when one model's
# quota runs out the next in the list is used. gemini-3.8-flash is left out because it
# took over 2 minutes per call (14 Nov).
LLM_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash

# Optional: seconds before a Gemini call is abandoned (default 90)
LLM_TIMEOUT_S=

# For LLM_PROVIDER=gemini
GEMINI_API_KEY=

# For LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional: OpenAI-compatible server, e.g. a local Ollama or LM Studio
OPENAI_BASE_URL=
